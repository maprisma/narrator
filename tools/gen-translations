#!/usr/bin/env python3
"""Compile repository catalogs for Rust, Flutter and the private setup bridge. No downloads."""
import json
from pathlib import Path
ROOT = Path(__file__).resolve().parent.parent
CODES = 'en de fr es it pt nl pl'.split()

def outputs():
    catalogs = {}
    for code in CODES:
        base = json.loads((ROOT / f'translations/{code}.json').read_text())
        extra = json.loads((ROOT / f'translations/extra/{code}.json').read_text())
        catalogs[code] = base | extra
    data = json.dumps(catalogs, ensure_ascii=False, indent=2) + '\n'
    # JSON is also a Dart map literal after escaping dollar interpolation.
    dart = '// Generated by tools/gen-translations. Do not edit.\nconst translations = <String, Map<String, String>>' + data.strip().replace('$', r'\$') + ';\n'
    python = '# Generated by tools/gen-translations. Do not edit.\nCATALOGS = ' + repr(catalogs) + '\n'
    return {'translations/compiled.json': data, 'settings/lib/translations.g.dart': dart, 'backend/translations_generated.py': python}

if __name__ == '__main__':
    for path, content in outputs().items():
        (ROOT / path).write_text(content)
